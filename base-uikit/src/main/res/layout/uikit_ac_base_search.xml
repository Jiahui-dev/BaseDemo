<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uikit_white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@color/uikit_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_12">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            app:tint="@color/uikit_icon"
            app:srcCompat="@drawable/uikit_icon_back" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:background="@drawable/uikit_shape_radius_20"
            android:backgroundTint="@color/uikit_grey">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="请输入搜索关键词"
                android:imeOptions="actionSearch"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_36"
                android:singleLine="true"
                android:textSize="@dimen/sp_14" />

            <ImageView
                android:id="@+id/iv_clear"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/dp_8"
                android:src="@drawable/uikit_icon_clear"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_action_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:text="搜索"
            android:textColor="@color/uikit_text_3" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/contentView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />

                <ViewStub
                    android:id="@+id/emptyStub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout="@layout/uikit_layout_empty_page" />

                <ViewStub
                    android:id="@+id/errorStub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout="@layout/uikit_layout_error_page" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="历史搜索"
                        android:textColor="@color/uikit_text_3"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_delete_history"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:layout_alignParentEnd="true"
                        android:padding="@dimen/dp_2"
                        app:tint="@color/uikit_icon"
                        android:src="@drawable/uikit_icon_delect" />
                </RelativeLayout>

                <com.yjh.base.uikit.widget.flow.FlowLayout
                    android:id="@+id/flow_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</LinearLayout>